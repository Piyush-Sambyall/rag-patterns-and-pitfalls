# Optional. Only needed to point at a non-default Ollama setup.
# Leave everything blank/commented to use the defaults below.

# Base URL of your local Ollama server (default shown).
# OLLAMA_HOST=http://localhost:11434

# Which pulled model to use for generation (default shown).
# OLLAMA_MODEL=llama

# Request timeout in seconds (default shown).
# OLLAMA_TIMEOUT=30

# If no Ollama server is reachable at OLLAMA_HOST when the app starts,
# generation automatically falls back to an offline extractive mode --
# no key, no signup, and no external API is ever required.
